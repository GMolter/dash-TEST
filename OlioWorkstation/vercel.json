{
  "headers": [
    { "source": "/auth/(.*)", "headers": [
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "Cache-Control", "value": "no-store" },
      { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
    ] },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/admin/logout", "destination": "/api/admin/login?action=logout" },
    { "source": "/((?!api(?:/|$)|assets(?:/|$)|app-assets(?:/|$)|sw\\.js$).*)", "destination": "/" }
  ]
}
